<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_generate_cyclical_cycles"
            model="ir.cron">
            <field name="name">Generar ciclos de inventario cíclico</field>
            <field name="model_id"
                ref="model_cyclical_inventory_cycle"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_cycles()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="user_id"
                ref="base.user_root"/>
        </record>
    </data>
</odoo>
